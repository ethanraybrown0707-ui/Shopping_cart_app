<Window x:Class="ShoppingCartApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Interaction delay" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="A short pause between each click or keystroke and its effect. A fresh random value in the range below is used for every interaction. Takes effect on the next one."/>

        <CheckBox x:Name="EnabledCheckBox" Content="Delay interactions" Margin="0,0,0,12"
                  Checked="EnabledCheckBox_Changed" Unchecked="EnabledCheckBox_Changed"
                  AutomationProperties.AutomationId="DelayEnabledCheckBox"
                  AutomationProperties.Name="Delay interactions"/>

        <Grid x:Name="RangeGrid" Margin="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Min (ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="MinTextBox" VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="DelayMinTextBox"
                     AutomationProperties.Name="Minimum delay milliseconds"/>
            <TextBlock Grid.Column="3" Text="Max (ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="4" x:Name="MaxTextBox" VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="DelayMaxTextBox"
                     AutomationProperties.Name="Maximum delay milliseconds"/>
        </Grid>

        <TextBlock x:Name="ValidationText" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"
                   AutomationProperties.AutomationId="SettingsValidationText"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Restore defaults" MinWidth="110" Margin="0,0,8,0" Padding="8,3"
                    Click="RestoreDefaults_Click"
                    AutomationProperties.AutomationId="SettingsRestoreDefaultsButton"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="72" Margin="0,0,8,0" Padding="8,3"
                    Click="Cancel_Click"/>
            <Button Content="OK" IsDefault="True" MinWidth="72" Padding="8,3"
                    Click="Ok_Click"
                    AutomationProperties.AutomationId="SettingsOkButton"/>
        </StackPanel>
    </StackPanel>
</Window>
