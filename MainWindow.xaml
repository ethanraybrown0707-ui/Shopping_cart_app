<Window x:Class="ShoppingCartApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoppingCartApp"
        mc:Ignorable="d"
        Title="Shopping Cart" Height="560" Width="880"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Sets the accessible name/id on each generated TabItem so a test can find a specific
             basket by its Header (e.g. "Basket 2") instead of by position. -->
        <Style x:Key="BasketTabItemStyle" TargetType="TabItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
            <Setter Property="AutomationProperties.AutomationId" Value="BasketTabItem"/>
        </Style>

        <!-- Flat, icon-only look for the per-tab close button, sized to sit inline with the
             tab's own text instead of reading as a separate boxed control. -->
        <Style x:Key="TabGlyphButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BasketHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                <!-- Tag carries the Basket this header belongs to, same Tag={Binding} pattern
                     BasketControl already uses for its per-row Add/Remove buttons. -->
                <Button Content="x" Tag="{Binding}" Margin="8,0,0,0"
                        Style="{StaticResource TabGlyphButtonStyle}"
                        AutomationProperties.AutomationId="CloseBasketButton"
                        AutomationProperties.Name="{Binding Header, StringFormat='Close {0}'}"
                        Click="CloseBasket_Click"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BasketContentTemplate">
            <local:BasketControl/>
        </DataTemplate>

        <!-- Puts a "+" button directly in the tab strip, next to the tab headers themselves
             (Chrome/Google-tabs style), instead of a separate labeled button above the tabs.
             Only the header row changes shape from the default TabControl template - the
             TabPanel (IsItemsHost) and the SelectedContent presenter are still the same named
             parts, so ItemContainerStyle/ItemTemplate/ContentTemplate above keep working as-is. -->
        <!-- TargetType is the local:TabControlWithAddButton subclass (see that file for why a
             plain TabControl won't work here): its automation peer specifically looks for this
             "+" button by its Tag marker and folds it into the automation tree, since a stock
             TabControl's peer only ever reports TabItem children and would otherwise make this
             button impossible for a test to find, despite it rendering fine on screen. -->
        <ControlTemplate x:Key="TabsWithAddButtonTemplate" TargetType="local:TabControlWithAddButton">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Left"
                              IsItemsHost="True" Panel.ZIndex="1"/>
                    <Button DockPanel.Dock="Left" Content="+" Margin="6,4,0,0"
                            VerticalAlignment="Bottom"
                            Tag="AddButton"
                            Style="{StaticResource TabGlyphButtonStyle}"
                            AutomationProperties.AutomationId="NewBasketButton"
                            AutomationProperties.Name="New Basket"
                            Click="NewBasketButton_Click"/>
                </DockPanel>
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </DockPanel>
        </ControlTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_History">
                <MenuItem Header="_Order History..." Click="OrderHistoryMenuItem_Click"
                          AutomationProperties.AutomationId="OrderHistoryMenuItem"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Interaction Delay..." Click="SettingsMenuItem_Click"
                          AutomationProperties.AutomationId="SettingsMenuItem"/>
            </MenuItem>
        </Menu>

        <local:TabControlWithAddButton x:Name="BasketsTabControl"
                    AutomationProperties.AutomationId="BasketsTabControl"
                    Template="{StaticResource TabsWithAddButtonTemplate}"
                    ItemContainerStyle="{StaticResource BasketTabItemStyle}"
                    ItemTemplate="{StaticResource BasketHeaderTemplate}"
                    ContentTemplate="{StaticResource BasketContentTemplate}"
                    Margin="10"/>
    </DockPanel>
</Window>
