<UserControl x:Class="ShoppingCartApp.BasketControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ShoppingCartApp"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="780">
    <UserControl.Resources>
        <!-- Flat, bordered look for the per-row "Images" dropdown so it reads as a button
             rather than bare menu text - same intent as MainWindow's TabGlyphButtonStyle. -->
        <Style x:Key="ImagesMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#ADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Favourite toggle: a grey star that turns gold when ticked (Foreground colours the
             "★" content; the tick box itself keeps its system look). -->
        <Style x:Key="FavouriteCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#BFBFBF"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#E8A317"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProductTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Favourite toggle. Two-way bound to Product.IsFavourite, which persists via
                     FavouritesStore; the Click handler adds a status line and re-floats the
                     catalog. Same shared-AutomationId / bound-Name-per-row pattern as the
                     buttons - Tag carries the Product for the handler. -->
                <CheckBox Grid.Column="0" Content="★" Margin="0,0,8,0" VerticalAlignment="Center"
                          Style="{StaticResource FavouriteCheckBoxStyle}"
                          ToolTip="Favourite" Tag="{Binding}"
                          IsChecked="{Binding IsFavourite, Mode=TwoWay}"
                          Click="FavouriteCheckBox_Click"
                          AutomationProperties.AutomationId="FavouriteCheckBox"
                          AutomationProperties.Name="{Binding Name, StringFormat='Favourite {0}'}"/>

                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayPrice}" VerticalAlignment="Center"
                           Margin="8,0" FontWeight="SemiBold"/>
                <!-- AutomationId is the same on every row (it's a shared template); AutomationProperties.Name
                     is bound per-row so tests can tell rows apart by product name. -->
                <Button Grid.Column="3" Content="Add to Cart" Tag="{Binding}"
                        AutomationProperties.AutomationId="AddToCartButton"
                        AutomationProperties.Name="{Binding Name, StringFormat='Add {0} to Cart'}"
                        Click="AddToCart_Click"/>

                <!-- "Images" dropdown: opens a menu of per-product image-search links, each
                     launched in the default browser (BasketControl.OpenImageLink_Click).
                     Same shared-AutomationId / bound-Name-per-row pattern as Add to Cart -
                     the child link items share ProductImageLinkItem across every row too.
                     Each link's target URL is in Tag (what the click handler opens) and also
                     in AutomationProperties.HelpText - so a screen reader announces where the
                     link goes, and a test can read/verify the exact destination. -->
                <Menu Grid.Column="4" Margin="8,0,0,0" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="Images ▾" Style="{StaticResource ImagesMenuItemStyle}"
                              AutomationProperties.AutomationId="ProductImagesMenuItem"
                              AutomationProperties.Name="{Binding Name, StringFormat='Images for {0}'}">
                        <MenuItem Header="Google Images" Tag="{Binding GoogleImagesUrl}" Click="OpenImageLink_Click"
                                  AutomationProperties.AutomationId="ProductImageLinkItem"
                                  AutomationProperties.HelpText="{Binding GoogleImagesUrl}"/>
                        <MenuItem Header="Bing Images" Tag="{Binding BingImagesUrl}" Click="OpenImageLink_Click"
                                  AutomationProperties.AutomationId="ProductImageLinkItem"
                                  AutomationProperties.HelpText="{Binding BingImagesUrl}"/>
                        <MenuItem Header="Wikipedia" Tag="{Binding WikipediaUrl}" Click="OpenImageLink_Click"
                                  AutomationProperties.AutomationId="ProductImageLinkItem"
                                  AutomationProperties.HelpText="{Binding WikipediaUrl}"/>
                    </MenuItem>
                </Menu>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CartItemTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayQuantity}" Margin="4,0" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="CartLineQuantityText"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayLineTotal}" Margin="4,0" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="CartLineTotalText"/>
                <!-- Same AutomationId-per-template / bound-Name-per-row pattern as Add to Cart.
                     One click removes one unit; the row itself disappears once Quantity hits 0. -->
                <Button Grid.Column="3" Content="Remove" Tag="{Binding}" Padding="4,1" FontSize="11"
                        AutomationProperties.AutomationId="RemoveFromCartButton"
                        AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from Cart'}"
                        Click="RemoveFromCart_Click"/>
            </Grid>
        </DataTemplate>

        <!-- Without this, UI Automation falls back to each row's ToString() for its accessible
             name, which makes test logs useless for telling rows apart. -->
        <Style x:Key="ItemContainerNameStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Per-basket status line - replaces the old window-level StatusBar now that each tab
             has its own independent state to report on. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Grid, not StackPanel, for each column's content: a vertical StackPanel measures
                 children with unbounded width, so the catalog ListBox's wide rows (name + price
                 + button) would grow past this column's allocated width and visually cover the
                 cart panel next to it. Grid rows constrain width to the column properly. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Products" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <!-- Every control below carries the same 4,0,0,0 margin (a label follows its
                         own control with a wider 12,0,0,0 gap, marking a new group) so the
                         spacing reads as consistent left-to-right instead of ad hoc per item. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <!-- Text is set/read from code-behind per-Basket (see Basket.SearchText's
                             remarks) rather than bound, matching SortComboBox/StatusText/TotalText's
                             existing imperative-sync pattern in this file. -->
                        <TextBox x:Name="SearchTextBox" Width="110" Margin="4,0,0,0"
                                 AutomationProperties.AutomationId="SearchTextBox"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <!-- SelectedIndex/sort is set from code-behind per-Basket (see
                             Basket.SortOrder's remarks) rather than bound, matching how
                             StatusText/TotalText are already set imperatively in this file. -->
                        <!-- Item order here must match the ProductSortOrder enum's declaration
                             order 1:1 - SortComboBox.SelectedIndex is cast directly to/from that
                             enum (see BasketControl.xaml.cs). Content text is kept short (arrows,
                             not "(A-Z)"/"(Low to High)") so the box itself can stay narrow instead
                             of dominating this row - Tag (what the code-behind reads) is unchanged. -->
                        <ComboBox x:Name="SortComboBox" Width="96" Margin="4,0,0,0"
                                  AutomationProperties.AutomationId="SortComboBox"
                                  SelectionChanged="SortComboBox_SelectionChanged">
                            <ComboBoxItem Content="Default" Tag="Default"
                                          AutomationProperties.AutomationId="SortDefaultItem"/>
                            <ComboBoxItem Content="Name ↑" Tag="NameAscending"
                                          AutomationProperties.AutomationId="SortNameAscendingItem"/>
                            <ComboBoxItem Content="Name ↓" Tag="NameDescending"
                                          AutomationProperties.AutomationId="SortNameDescendingItem"/>
                            <ComboBoxItem Content="Price ↑" Tag="PriceAscending"
                                          AutomationProperties.AutomationId="SortPriceAscendingItem"/>
                            <ComboBoxItem Content="Price ↓" Tag="PriceDescending"
                                          AutomationProperties.AutomationId="SortPriceDescendingItem"/>
                            <ComboBoxItem Content="★ First" Tag="FavouritesFirst"
                                          AutomationProperties.AutomationId="SortFavouritesFirstItem"/>
                        </ComboBox>
                        <!-- Filter: when ticked, ApplyFilter also requires IsFavourite, AND-ed
                             with the search text. Per-Basket state (Basket.FavouritesOnly). -->
                        <CheckBox x:Name="FavouritesOnlyCheckBox" Content="★ only"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="Show only favourited products"
                                  Checked="FavouritesOnlyCheckBox_Toggled"
                                  Unchecked="FavouritesOnlyCheckBox_Toggled"
                                  AutomationProperties.AutomationId="FavouritesOnlyCheckBox"
                                  AutomationProperties.Name="Show favourites only"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" x:Name="CatalogListBox"
                         AutomationProperties.AutomationId="CatalogListBox"
                         ItemTemplate="{StaticResource ProductTemplate}"
                         ItemContainerStyle="{StaticResource ItemContainerNameStyle}"/>
            </Grid>

            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Cart" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" x:Name="CartListBox"
                         AutomationProperties.AutomationId="CartListBox"
                         ItemTemplate="{StaticResource CartItemTemplate}"
                         ItemContainerStyle="{StaticResource ItemContainerNameStyle}"/>

                <!-- Text is set from code-behind at startup (UpdateTotal) rather than hardcoded
                     here, so it always matches the runtime currency format ({0:C} follows the
                     OS locale - e.g. "£0.00" on this machine, not necessarily "$0.00"). -->
                <TextBlock Grid.Row="2" x:Name="TotalText" Margin="0,10,0,0" FontWeight="Bold"
                           AutomationProperties.AutomationId="TotalText"/>

                <Button Grid.Row="3" x:Name="CheckoutButton" Content="Checkout" Margin="0,10,0,0" Padding="8,4"
                        AutomationProperties.AutomationId="CheckoutButton"
                        Click="Checkout_Click"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
