<Window x:Class="ShoppingCartApp.OrderHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Order History" Height="480" Width="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Order History" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

        <!-- Shown only when there's nothing to list yet - a bare empty ListBox reads as broken,
             not "no orders yet". -->
        <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" Text="No orders placed yet."
                   Foreground="Gray" Margin="0,0,0,8" Visibility="Collapsed"
                   AutomationProperties.AutomationId="EmptyOrderHistoryText"/>

        <ListBox x:Name="OrdersListBox" AutomationProperties.AutomationId="OrdersListBox"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplaySummary}" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="OrderSummaryText"/>
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" Margin="12,1,0,0" FontSize="11" Foreground="#555555"
                                                   AutomationProperties.AutomationId="OrderLineText"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
